{
  "name": "dagman",
  "version": "0.1.3",
  "description": "dagman - DAG-based agent task orchestration CLI",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./api": {
      "import": "./dist/api.js",
      "types": "./dist/api.d.ts"
    }
  },
  "bin": {
    "dagman": "dist/bin/dagman.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsdown",
    "dev": "tsx bin/dagman.ts",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src bin tests",
    "lint:fix": "eslint src bin tests --fix",
    "lint:deps": "depcruise src bin",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"bin/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"bin/**/*.ts\" \"tests/**/*.ts\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run lint:deps",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "files": [
    "dist",
    "src/api/",
    "src/shared/",
    "src/slices/",
    "examples/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "neverthrow": "^8.2.0",
    "picocolors": "^1.1.1",
    "remeda": "^2.37.0",
    "ts-pattern": "^5.9.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.7",
    "dependency-cruiser": "^17.4.2",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "tsdown": "^0.22.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  }
}
